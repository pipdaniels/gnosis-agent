# Example environment variables for GNOSISAGENT Platform
# Copy this file to .env and update with your values

# Organization Configuration
ORG_ID=demo_org
ORG_NAME=Demo_Organization

# MongoDB Configuration
MONGO_PASSWORD=greenhay
GNOSISAGENT_MONGODB_URI=mongodb://seun:greenhay@localhost:27017
mongodb://localhost:27017/
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
GNOSISAGENT_SERVER_PORT=8080
GNOSISAGENT_SERVER_HOST=0.0.0.0

# Admin Interface (for mongo-express)
ADMIN_PASSWORD=your_admin_password_here

# Optional: Security
JWT_SECRET=your_jwt_secret_here
ENABLE_AUTH=false

# Optional: Logging
LOG_LEVEL=info
LOG_FORMAT=json
