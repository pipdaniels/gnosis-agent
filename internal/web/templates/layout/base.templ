package layout

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Gnosis Agent - AI-Powered Geochemical Analysis Platform"/>
			<meta name="theme-color" content="#1a73e8"/>
			<title>{ title } - Gnosis Agent</title>
			<!-- PWA Manifest -->
			<link rel="manifest" href="/static/manifest.json"/>
			<link rel="icon" type="image/png" href="/static/icon-192.png"/>
			<link rel="apple-touch-icon" href="/static/icon-512.png"/>
			<!-- Stylesheets -->
			<link rel="stylesheet" href="/static/css/main.css"/>
			<link rel="stylesheet" href="/static/css/components.css"/>
			<!-- Leaflet for maps -->
			<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
			<!-- Scripts -->
			<script src="/static/js/db.js" defer></script>
			<script src="/static/js/app.js" defer></script>
			<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
			<!-- Register Service Worker -->
			<script>
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.register('/sw.js');
			}
		</script>
		</head>
		<body>
			<div class="app-container">
				@Navigation(title)
				<main class="main-content">
					{ children... }
				</main>
				@Footer()
			</div>
			<div id="toast-container"></div>
		</body>
	</html>
}

templ Navigation(title string) {
	<nav class="navbar">
		<div class="nav-container">
			<div class="nav-brand">
				<span class="logo">🔬</span>
				<span class="brand-text">Gnosis Agent</span>
			</div>
			<div class="nav-links">
				<a href="/dashboard" class={ "nav-link", templ.KV("active", title == "Dashboard") }>
					Dashboard
				</a>
				<a href="/upload" class={ "nav-link", templ.KV("active", title == "Upload") }>
					Upload
				</a>
				<a href="/datasets" class={ "nav-link", templ.KV("active", title == "Datasets") }>
					Datasets
				</a>
				<a href="/targets" class={ "nav-link", templ.KV("active", title == "Targets") }>
					Targets
				</a>
				<a href="/decisions" class={ "nav-link", templ.KV("active", title == "Decisions") }>
					Decisions
				</a>
				<a href="/reports" class={ "nav-link", templ.KV("active", title == "Reports") }>
					Reports
				</a>
			</div>
			<div class="nav-actions">
				<button class="btn btn-outline btn-sm" id="theme-toggle">
					<span class="icon">🌙</span>
				</button>
				<a href="/settings/team" class={ "btn-icon-nav", templ.KV("active", title == "Team Settings") } title="Team Settings" style="text-decoration: none; font-size: 1.3rem; display: flex; align-items: center; padding: 4px 8px; border-radius: 8px; transition: background 0.2s;">
					⚙️
				</a>
				<a href="/profile" class="user-profile" style="text-decoration: none;">
					<div class="avatar">👤</div>
				</a>
			</div>
		</div>
	</nav>
}

templ Footer() {
	<footer class="footer">
		<div class="footer-container">
			<div class="footer-info">
				<p>&copy; 2026 Gnosis, a GNOSISAGENT.</p>
				<p class="powered-by">Powered by Sipstory LTD.</p>
			</div>
			<div class="footer-links">
				<a href="/docs">Docs</a>
				<a href="/api">API</a>
				<a href="/about">About</a>
				<a href="/privacy">Privacy</a>
			</div>
		</div>
	</footer>
}
