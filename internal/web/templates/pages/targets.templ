package pages

import "gnosis-agent/internal/web/templates/layout"
import "gnosis-agent/internal/models"

templ Targets(processedDatasets []models.ProcessedDataset, anomalies []models.AnomalyResults, prospectivities []models.ProspectivityResults) {
	@layout.Base("Targets") {
		<!-- Load Plotly for Data Visualization -->
		<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>

		@templ.JSONScript("p-data", processedDatasets)
		@templ.JSONScript("a-data", anomalies)
		@templ.JSONScript("pr-data", prospectivities)

		<div class="page-container" style="max-width: 1400px; margin: 2rem auto; padding: 0 1rem; font-family: sans-serif;">
			if len(processedDatasets) == 0 {
				<div class="empty-state" style="text-align: center; padding: 4rem 2rem; background: #f9fafb; border: 1px dashed #d1d5db; border-radius: 12px; margin-top: 2rem;">
					<div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; background: #e0e7ff; color: #4f46e5; margin-bottom: 1.5rem;">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-radar"><path d="M19.07 4.93A10 10 0 0 0 6.99 3.34"/><path d="M4 6h.01"/><path d="M2.29 9.62A10 10 0 1 0 21.31 8.35"/><path d="M16.24 7.76A6 6 0 1 0 8.23 16.67"/><path d="M12 18h.01"/><path d="M17.99 11.66A6 6 0 0 1 15.77 16.67"/><circle cx="12" cy="12" r="2"/><path d="m13.41 10.59 5.66-5.66"/></svg>
					</div>
					<h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #111827;">No Analyzed Targets Available</h3>
					<p style="color: #6b7280; max-width: 400px; margin: 0 auto 2rem auto; line-height: 1.5;">Process your raw geochemical datasets through our ML pipeline to generate robust anomaly and prospectivity targets.</p>
					<a href="/upload" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; background: #1a73e8; color: white; padding: 0.6rem 1.2rem; border-radius: 6px; font-weight: 500;">
						Upload Raw Data
					</a>
				</div>
			} else {
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
					<h1 style="margin: 0; font-size: 1.8rem; color: #111827;">Mineral Targets Visualizer</h1>
					<select id="dataset-selector" class="form-select" style="padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid #d1d5db; background: white; font-weight: 500; cursor: pointer; min-width: 200px;">
						for _, ds := range processedDatasets {
							<option value={ ds.DatasetID }>{ ds.DatasetID }</option>
						}
					</select>
				</div>
				<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
					<div class="card" style="background: white; border-radius: 12px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); padding: 1.5rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f3f4f6; padding-bottom: 0.5rem; margin-bottom: 1rem;">
							<h3 style="margin: 0; color: #374151; font-size: 1.1rem;">3D Spatial Multi-Dimensional Target Map</h3>
							<span style="background: #fef3c7; color: #92400e; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">MDS VISUALIZATION</span>
						</div>
						<div id="plot-3d" style="width: 100%; height: 500px;"></div>
					</div>
					<div style="display: flex; flex-direction: column; gap: 1.5rem;">
						<div class="card" style="background: white; border-radius: 12px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); padding: 1.5rem; flex: 1;">
							<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f3f4f6; padding-bottom: 0.5rem; margin-bottom: 1rem;">
								<h3 style="margin: 0; color: #374151; font-size: 1.1rem;">Anomaly Intensity Profile</h3>
								<span style="background: #e0e7ff; color: #3730a3; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">Z-SCORE</span>
							</div>
							<div id="plot-bar" style="width: 100%; height: 200px;"></div>
						</div>
						<div class="card" style="background: white; border-radius: 12px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); padding: 1.5rem; flex: 1; overflow-y: auto;">
							<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f3f4f6; padding-bottom: 0.5rem; margin-bottom: 1rem;">
								<h3 style="margin: 0; color: #374151; font-size: 1.1rem;">Exploration Rationale</h3>
								<span style="background: #ecebff; color: #4338ca; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">TEXT MINING</span>
							</div>
							<div id="rationale-tags" style="display: flex; flex-wrap: wrap; gap: 0.5rem;"></div>
						</div>
					</div>
				</div>
				<div class="card" style="background: white; border-radius: 12px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); padding: 1.5rem;">
					<h3 style="margin-top: 0; color: #374151; font-size: 1.1rem; border-bottom: 1px solid #f3f4f6; padding-bottom: 0.5rem; margin-bottom: 1rem;">Prospectivity Decision Matrix</h3>
					<div class="table-responsive">
						<table style="width: 100%; border-collapse: collapse; text-align: left;" id="targets-table">
							<thead>
								<tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
									<th style="padding: 1rem; font-size: 0.85rem; color: #4b5563; font-weight: 600;">Target ID</th>
									<th style="padding: 1rem; font-size: 0.85rem; color: #4b5563; font-weight: 600;">Status Indicator</th>
									<th style="padding: 1rem; font-size: 0.85rem; color: #4b5563; font-weight: 600;">Prospectivity Score</th>
									<th style="padding: 1rem; font-size: 0.85rem; color: #4b5563; font-weight: 600;">Confidence Level</th>
									<th style="padding: 1rem; font-size: 0.85rem; color: #4b5563; font-weight: 600;">Action</th>
								</tr>
							</thead>
							<tbody id="targets-tbody">
								<!-- Injected by JavaScript -->
							</tbody>
						</table>
					</div>
				</div>
				<script>
                    document.addEventListener("DOMContentLoaded", () => {
                        const pDataStr = document.getElementById("p-data").textContent;
                        const aDataStr = document.getElementById("a-data").textContent;
                        const prDataStr = document.getElementById("pr-data").textContent;
                        
                        let processed = []; let anomalies = []; let prospectivities = [];
                        try { processed = JSON.parse(pDataStr); } catch(e){}
                        try { anomalies = JSON.parse(aDataStr); } catch(e){}
                        try { prospectivities = JSON.parse(prDataStr); } catch(e){}
                        
                        const selector = document.getElementById("dataset-selector");
                        
                        function renderDashboard(datasetID) {
                            if(!datasetID) return;
                            
                            // Find corresponding anomaly & prospectivity
                            const anom = anomalies.find(a => a.dataset_id === datasetID);
                            const pros = prospectivities.find(p => p.dataset_id === datasetID);
                            
                            // fallback logic if missing
                            const targets = pros ? (pros.targets || []) : [];
                            const results = anom ? (anom.results || []) : [];
                            
                            // 1. Build 3D Scatter (X, Y, Z coordinates + sizes based on Confidence/Score)
                            let x = [], y = [], z = [], sizes = [], texts = [], colors = [];
                            targets.forEach(t => {
                                x.push(t.location.longitude || (Math.random()*10 - 5));
                                y.push(t.location.latitude || (Math.random()*10 - 5));
                                z.push(t.location.elevation || (Math.random()*-500)); // depth metric
                                
                                let score = t.prospectivity_score || 0.1;
                                sizes.push(Math.max(12, score * 35));
                                colors.push(score);
                                texts.push(`<b>${t.target_id}</b><br>Score: ${score.toFixed(2)}<br>Confidence: ${(t.confidence || 0).toFixed(2)}`);
                            });
                            
                            let trace = {
                                x: x, y: y, z: z, mode: 'markers',
                                marker: {
                                    size: sizes,
                                    color: colors,
                                    colorscale: 'Viridis',
                                    showscale: true,
                                    opacity: 0.85,
                                    line: { color: 'white', width: 0.5 }
                                },
                                text: texts,
                                hoverinfo: 'text',
                                type: 'scatter3d'
                            };
                            let layout3d = { 
                                margin: { l:0, r:0, b:0, t:0 }, 
                                paper_bgcolor: 'transparent',
                                scene: {
                                    xaxis: { title: 'Easting / Lon' },
                                    yaxis: { title: 'Northing / Lat' },
                                    zaxis: { title: 'Elevation' }
                                }
                            };
                            Plotly.newPlot('plot-3d', [trace], layout3d, {responsive: true});
                            
                            // 2. Build Bar plot for Anomaly Intensities
                            // Sort top 10 anomalies
                            let sorted = [...results].sort((a,b) => (b.anomaly_score||0) - (a.anomaly_score||0)).slice(0, 10);
                            let barX = sorted.map(s => s.sample_id);
                            let barY = sorted.map(s => s.anomaly_score);
                            let barTrace = { 
                                x: barX, 
                                y: barY, 
                                type: 'bar', 
                                marker: { 
                                    color: barY, 
                                    colorscale: 'Portland',
                                    border: { width: 1, color: '#333' }
                                } 
                            };
                            let barLayout = { 
                                margin: { l:30, r:10, b:40, t:10 }, 
                                paper_bgcolor: 'transparent',
                                plot_bgcolor: 'transparent',
                                xaxis: { type: 'category', tickangle: -45, title: 'Sample ID' },
                                yaxis: { title: 'Intensity' }
                            };
                            Plotly.newPlot('plot-bar', [barTrace], barLayout, {responsive: true});
                            
                            // 3. Populate Word/Tag Cloud Rationale & Go-No-Go Priorities
                            const tagsDiv = document.getElementById("rationale-tags");
                            const tbody = document.getElementById("targets-tbody");
                            tagsDiv.innerHTML = "";
                            tbody.innerHTML = "";
                            
                            if (targets.length === 0) {
                                tagsDiv.innerHTML = "<p style='color:#6b7280; font-size:0.9rem;'>No text mining rationale data to display for this model.</p>";
                                tbody.innerHTML = "<tr><td colspan='5' style='padding:1.5rem;color:#6b7280;text-align:center;'>Awaiting processing. No targets found for this spatial dataset.</td></tr>";
                                return;
                            }
                            
                            let words = {};
                            targets.forEach(t => {
                                // Add table row
                                let tr = document.createElement("tr");
                                tr.style.borderBottom = "1px solid #e5e7eb";
                                let score = t.prospectivity_score || 0;
                                let isDrill = score >= 0.65; // Mineral threshold logic
                                
                                let badge = isDrill 
                                    ? `<span style="background: #ecfcce; color: #3f6212; padding: 0.3rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px;">GO / DRILL</span>` 
                                    : `<span style="background: #fee2e2; color: #991b1b; padding: 0.3rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px;">NO GO</span>`;

                                tr.innerHTML = `
                                    <td style="padding: 1rem; font-weight: 500; font-family: monospace;">${t.target_id}</td>
                                    <td style="padding: 1rem;">${badge}</td>
                                    <td style="padding: 1rem; font-weight: 500; color: #111827;">${(score * 100).toFixed(1)}%</td>
                                    <td style="padding: 1rem;">${(t.confidence||0).toFixed(2)}</td>
                                    <td style="padding: 1rem;"><button class="btn btn-outline btn-sm" onclick="alert('Viewing comprehensive lithological details for ${t.target_id}')" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">Investigate</button></td>
                                `;
                                tbody.appendChild(tr);

                                if(t.rationale) {
                                    t.rationale.forEach(r => {
                                        words[r] = (words[r] || 0) + 1;
                                    });
                                }
                            });
                            
                            // Visualize Keywords centrality
                            const sortedWords = Object.keys(words).sort((a,b) => words[b] - words[a]).slice(0, 18);
                            sortedWords.forEach((w, index) => {
                                let weightObj = words[w];
                                let fSize = Math.max(0.75, Math.min(1.4, weightObj * 0.15 + 0.75));
                                let intensitySpan = document.createElement("span");
                                intensitySpan.innerText = w;
                                
                                // Apply colorful tags mimicking centrality
                                const colors = ['#eff6ff', '#f0fdf4', '#fefce8', '#fdf2f8', '#f5f3ff'];
                                const borders = ['#bfdbfe', '#bbf7d0', '#fef08a', '#fbcfe8', '#ddd6fe'];
                                const texts = ['#1d4ed8', '#15803d', '#a16207', '#be185d', '#6d28d9'];
                                
                                let cInd = index % colors.length;
                                intensitySpan.style.background = colors[cInd];
                                intensitySpan.style.color = texts[cInd];
                                intensitySpan.style.padding = "0.3rem 0.8rem";
                                intensitySpan.style.borderRadius = "99px";
                                intensitySpan.style.border = "1px solid " + borders[cInd];
                                intensitySpan.style.fontSize = fSize + "rem";
                                intensitySpan.style.fontWeight = "500";
                                intensitySpan.style.whiteSpace = "nowrap";
                                intensitySpan.style.transition = "transform 0.2s";
                                intensitySpan.onmouseover = () => { intensitySpan.style.transform = "scale(1.05)"; };
                                intensitySpan.onmouseout = () => { intensitySpan.style.transform = "scale(1)"; };
                                
                                tagsDiv.appendChild(intensitySpan);
                            });
                            
                            if (sortedWords.length === 0) {
                                tagsDiv.innerHTML = "<p style='color:#9ca3af; font-size:0.9rem; font-style: italic;'>Text extraction pending for this target rationale.</p>";
                            }
                        }
                        
                        selector.addEventListener("change", (e) => {
                            renderDashboard(e.target.value);
                        });
                        
                        // Default render sequence
                        if (processed.length > 0) {
                            renderDashboard(processed[0].dataset_id);
                        }
                    });
                </script>
			}
		</div>
	}
}
