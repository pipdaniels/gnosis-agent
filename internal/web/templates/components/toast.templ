package components

type ToastType string

const (
	ToastSuccess ToastType = "success"
	ToastWarning ToastType = "warning"
	ToastError   ToastType = "error"
	ToastInfo    ToastType = "info"
)

templ Toast(title, message string, toastType ToastType) {
	<div class={ "toast", string(toastType) } role="alert">
		<div class="toast-icon">
			if toastType == ToastSuccess {
				✅
			} else if toastType == ToastWarning {
				⚠️
			} else if toastType == ToastError {
				❌
			} else {
				ℹ️
			}
		</div>
		<div class="toast-content">
			if title != "" {
				<div class="toast-title">{ title }</div>
			}
			<div class="toast-message">{ message }</div>
		</div>
		<button class="toast-close" onclick="this.parentElement.remove()" aria-label="Close">
			&times;
		</button>
	</div>
}
