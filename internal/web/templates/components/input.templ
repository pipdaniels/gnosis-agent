package components

templ Input(label, id, name, type_, placeholder string, required bool, helpText string) {
	<div class="form-group">
		<label for={ id }>
			{ label }
			if required {
				<span class="required">*</span>
			}
		</label>
		if type_ == "password" {
			<div class="password-wrapper" style="position: relative; display: flex; align-items: center; width: 100%;">
				<input
					type={ type_ }
					id={ id }
					name={ name }
					placeholder={ placeholder }
					if required {
						required
					}
					class="input-field"
					style="padding-right: 2.5rem; width: 100%; box-sizing: border-box;"
				/>
				<button type="button" onclick="
					let inp = this.previousElementSibling;
					let svgEye = this.querySelector('.eye-icon');
					let svgEyeOff = this.querySelector('.eye-off-icon');
					if(inp.type === 'password') { 
						inp.type = 'text'; 
						svgEye.style.display = 'none';
						svgEyeOff.style.display = 'block';
					} else { 
						inp.type = 'password'; 
						svgEye.style.display = 'block';
						svgEyeOff.style.display = 'none';
					}" 
					style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #6b7280; display: flex; align-items: center; justify-content: center; padding: 0;">
					<svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block;">
						<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
						<circle cx="12" cy="12" r="3"></circle>
					</svg>
					<svg class="eye-off-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
						<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
						<path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
						<path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
						<line x1="2" y1="2" x2="22" y2="22"></line>
					</svg>
				</button>
			</div>
		} else {
			<input
				type={ type_ }
				id={ id }
				name={ name }
				placeholder={ placeholder }
				if required {
					required
				}
				class="input-field"
			/>
		}
		if helpText != "" {
			<small class="form-hint">{ helpText }</small>
		}
	</div>
}
